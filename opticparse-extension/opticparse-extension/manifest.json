{
  "manifest_version": 3,
  "name": "OpticParse BYOB Extractor",
  "version": "1.0.0",
  "description": "Extract structured JSON from any page using Vision AI.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://opticparse-api.onrender.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Extract with OpticParse"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
